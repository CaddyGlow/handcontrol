<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp">

    <!-- Main card container -->
    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/system_accent1_100"
        android:elevation="2dp"
        android:outlineProvider="paddedBounds"
        android:clipToOutline="true">

        <LinearLayout
            android:id="@+id/widget_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="12dp"
            android:background="?android:attr/selectableItemBackground">

            <!-- Command icon -->
            <ImageView
                android:id="@+id/widget_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_media_play"
                android:contentDescription="Command icon"
                android:tint="@android:color/system_accent1_600" />

            <!-- Command name -->
            <TextView
                android:id="@+id/widget_command_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Command"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@android:color/system_neutral1_900"
                android:maxLines="2"
                android:ellipsize="end"
                android:gravity="center" />

            <!-- Server name (optional, shown in smaller text) -->
            <TextView
                android:id="@+id/widget_server_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Server"
                android:textSize="11sp"
                android:textColor="@android:color/system_neutral1_700"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Loading overlay -->
        <FrameLayout
            android:id="@+id/widget_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3FFFFFF"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:indeterminateTint="@android:color/system_accent1_600" />

        </FrameLayout>

        <!-- Success feedback overlay -->
        <FrameLayout
            android:id="@+id/widget_success"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B300C853"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✓"
                android:textSize="48sp"
                android:textColor="@android:color/white"
                android:contentDescription="Success" />

        </FrameLayout>

        <!-- Error overlay -->
        <FrameLayout
            android:id="@+id/widget_error"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B3F44336"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="✕"
                android:textSize="32sp"
                android:textColor="@android:color/white"
                android:contentDescription="Error" />

        </FrameLayout>

    </FrameLayout>

</FrameLayout>
